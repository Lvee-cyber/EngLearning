[{"term":"ah","translation":"用以表示惊奇；喜悦；赞美；同情等)；啊；原来你在这儿；啊；太好了；公共汽车来了","phonetic":"/ ɑː:; ɑː/","pronunciation":"/ ɑː:; ɑː/"},{"term":"aha","translation":"尤用以表示惊奇或胜利)；啊哈；原来她把钱藏在这儿了","phonetic":"/ ɑː:ˈhɑː:; ɑːˈhɑː/","pronunciation":"/ ɑː:ˈhɑː:; ɑːˈhɑː/"},{"term":"ahead","translation":"（在空间或时间上）向前；往前；朝前；在前；他跑在前面","phonetic":"/ əˈhed; əˈhed/","pronunciation":"/ əˈhed; əˈhed/"},{"term":"ahem","translation":"书面语中用以表示清嗓子的声音；尤用以引人注意；表示不以为然或用以赢得时间)；啊哼；我可以提个建议吗","phonetic":"/ əˈhəm; əˈhem/","pronunciation":"/ əˈhəm; əˈhem/"},{"term":"ahoy","translation":"船员们用以引人注意的呼喊声)；啊呣；啊；看到陆地","phonetic":"/ əˈhɔːɪ; əˈhɔːɪ/","pronunciation":"/ əˈhɔːɪ; əˈhɔːɪ/"}]