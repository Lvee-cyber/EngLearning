[{"term":"ghastly","translation":"可怕的；恐怖的；可怕的事故、经历、惊吓、谋杀","phonetic":"/ ˈgɑː:stlɪ; ˈgæstlɪ; ˈgæstlɪ/","pronunciation":"/ ˈgɑː:stlɪ; ˈgæstlɪ; ˈgæstlɪ/"},{"term":"ghat","translation":"（印度的）（河边或湖边供人上下的）台阶；通常作复数)(；河边火葬地（河边台阶顶部平台；为印度人火化尸体处）","pos":"N","phonetic":"/ gɔːt; gɔːt/","pronunciation":"/ gɔːt; gɔːt/"},{"term":"ghee","translation":"（印度烹饪用的半流质的）精炼奶油","pos":"N","phonetic":"/ giː; gi/","pronunciation":"/ giː; gi/"},{"term":"gherkin","translation":"（作泡菜的）小黄瓜","pos":"N","phonetic":"/ ˈgɜːkɪn; ˈgɜːkɪn/","pronunciation":"/ ˈgɜːkɪn; ˈgɜːkɪn/"},{"term":"ghetto","translation":"（旧时某些国家的）城市中的犹太人区；常作贬义)；少数民族居住区","phonetic":"/ ˈgetəʊ; ˈgeto/","pronunciation":"/ ˈgetəʊ; ˈgeto/"},{"term":"ghettoisation","translation":"大功率手提式大型收音录音机","pos":"N","phonetic":"/ ˌgetəʊaɪˈzeɪʃn; -əʊɪˈz-; ˌgetoəˈzeʃən/","pronunciation":"/ ˌgetəʊaɪˈzeɪʃn; -əʊɪˈz-; ˌgetoəˈzeʃən/"},{"term":"ghettoization","translation":"大功率手提式大型收音录音机","pos":"N","phonetic":"/ ˌgetəʊaɪˈzeɪʃn; -əʊɪˈz-; ˌgetoəˈzeʃən/","pronunciation":"/ ˌgetəʊaɪˈzeɪʃn; -əʊɪˈz-; ˌgetoəˈzeʃən/"},{"term":"ghost","translation":"幽灵；据说玛格丽特女士的鬼魂常在这个礼拜堂出没；我不相信有鬼","phonetic":"/ gəʊst; gost/","pronunciation":"/ gəʊst; gost/"},{"term":"ghostly","translation":"鬼的；（外貌或声音）像鬼的；在某人耳边低语的幽灵般的声音","phonetic":"/ ˈgəʊstlɪ; ˈgostlɪ/","pronunciation":"/ ˈgəʊstlɪ; ˈgostlɪ/"},{"term":"ghoul","translation":"（故事中的）盗墓食尸鬼；贬)；以死亡、灾难等恶事为乐的人","phonetic":"/ guːl; gul/","pronunciation":"/ guːl; gul/"},{"term":"ghoulish","translation":"食尸鬼似的；极为讨厌的；令人毛骨悚然的","phonetic":"/ ˈguːlɪʃ; ˈgulɪʃ/","pronunciation":"/ ˈguːlɪʃ; ˈgulɪʃ/"},{"term":"ghq","translation":"缩写；总司令部发来的命令","phonetic":"/ ˌdʒiːeɪtʃˈkjuː; ˌdʒietʃˈkju/","pronunciation":"/ ˌdʒiːeɪtʃˈkjuː; ˌdʒietʃˈkju/"}]