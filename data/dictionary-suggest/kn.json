[{"term":"knavery","translation":"古)；不诚实；欺诈","pos":"N","phonetic":"/ ˈneɪvərɪ; ˈnevərɪ/","pronunciation":"/ ˈneɪvərɪ; ˈnevərɪ/"},{"term":"knead","translation":"揉；捏（面团、湿黏土等）；)把面团揉成球形；按摩；揉捏（肌肉等）","pos":"V","phonetic":"/ niːd; nid/","pronunciation":"/ niːd; nid/"},{"term":"knee","translation":"膝盖；插图；（人坐著时）大腿的朝上的面","pos":"N","phonetic":"/ niː; ni/","pronunciation":"/ niː; ni/"},{"term":"knighthood","translation":"爵士或骑士的称号和身分；女王授予他爵士称号；爵士或骑士的身分、品德或尊严","pos":"N","phonetic":"/ -hUd; -hJd/","pronunciation":"/ -hUd; -hJd/"},{"term":"knock","translation":"短促的敲或打（的声音）；是有人敲门吗；要是八点钟你还不起床；我就来敲你的门","pos":"N","phonetic":"/ nɒk; nɑːk/","pronunciation":"/ nɒk; nɑːk/"},{"term":"knocker","translation":"门环；见附录；插图","pos":"N","phonetic":"/ ˈnɒkə(r); ˈnɑːkə/","pronunciation":"/ ˈnɒkə(r); ˈnɑːkə/"},{"term":"knot","translation":"（绳索等的）结；在绳头上打个结；打个结实的结把这两条绳系在一起","pos":"N","phonetic":"/ nɒt; nɑːt/","pronunciation":"/ nɒt; nɑːt/"},{"term":"knowing","translation":"（对别人不知道的秘密）知悉的；心照不宣的；显出了解内情的样子、眼光、表情等；世故的","pos":"Adj","phonetic":"/ ˈnəʊɪŋ; ˈnoɪŋ/","pronunciation":"/ ˈnəʊɪŋ; ˈnoɪŋ/"},{"term":"knuckle","translation":"指节；指关节；擦破指关节","pos":"N","phonetic":"/ ˈnʌkl; ˈnʌkl/","pronunciation":"/ ˈnʌkl; ˈnʌkl/"}]